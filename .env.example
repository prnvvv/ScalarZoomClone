# Environment variables for local development.
#
# Nothing loads .env automatically (the project does not depend on
# python-dotenv), so export the values in your shell before starting the app,
# or copy the per-package examples and source them:
#
#   backend/.env.example        -> DATABASE_URL, FRONTEND_URL, STUN_SERVER, APP_NAME
#   frontend/.env.local.example -> NEXT_PUBLIC_API_URL, NEXT_PUBLIC_STUN_SERVER

# Backend origin. The frontend calls REST and opens the WebSocket here.
BACKEND_URL=http://localhost:8000

# Frontend origin. The backend allows this origin through CORS and uses it to
# build meeting_link values.
FRONTEND_URL=http://localhost:3000
